PORT=5000
MONGO_URI=your_mongodb_connection_string
GEMINI_API_KEY=your_gemini_api_key

# Optional n8n bridge. The app remains fully functional when these are empty.
# In n8n use a Webhook node with POST and configure the same secret in its
# header validation or an IF node checking X-Aryan-Tracker-Secret.
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/aryan-tracker
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
N8N_TIMEOUT_MS=5000
